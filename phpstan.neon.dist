parameters:
    level: 5
    paths:
        - src
        - database
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    # The public API validates its documented argument types at runtime as well.
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Both managers are singletons that receive the application, like Laravel's own
        # managers; WizardServiceProvider::registerOctaneListeners() points them at every
        # new Octane sandbox, which is what this rule asks for.
        -
            identifier: larastan.octaneCompatibility
            path: src/WizardServiceProvider.php
            count: 2
