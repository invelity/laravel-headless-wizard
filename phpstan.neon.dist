parameters:
    level: 5
    paths:
        - src
        - database
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # The store manager is a singleton that receives the application, like Laravel's own
        # managers; WizardServiceProvider::registerOctaneListeners() points it at every new
        # Octane sandbox, which is what this rule asks for.
        -
            identifier: larastan.octaneCompatibility
            path: src/WizardServiceProvider.php
            count: 1
